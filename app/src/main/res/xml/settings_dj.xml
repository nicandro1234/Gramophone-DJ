<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="dj_mode_enabled"
        android:summary="@string/settings_dj_enable_summary"
        android:title="@string/settings_dj_enable_title" />

    <EditTextPreference
        android:dialogTitle="@string/settings_dj_deepseek_key_title"
        android:key="deepseek_api_key"
        android:summary="@string/settings_dj_deepseek_key_summary"
        android:title="@string/settings_dj_deepseek_key_title" />

    <ListPreference
        android:defaultValue="deepseek-v4.1-flash"
        android:dialogTitle="@string/settings_dj_model_title"
        android:entries="@array/dj_default_model_entries"
        android:entryValues="@array/dj_default_model_values"
        android:key="dj_api_model"
        android:summary="@string/settings_dj_model_summary"
        android:title="@string/settings_dj_model_title"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        android:dialogTitle="@string/settings_dj_model_custom_title"
        android:key="dj_api_model_custom"
        android:summary="@string/settings_dj_model_custom_summary"
        android:title="@string/settings_dj_model_custom_title"
        app:isPreferenceVisible="false" />

    <Preference
        android:key="dj_fetch_models"
        android:summary="@string/settings_dj_fetch_models_summary"
        android:title="@string/settings_dj_fetch_models_title" />

    <EditTextPreference
        android:dialogTitle="@string/settings_dj_endpoint_title"
        android:key="dj_api_endpoint"
        android:summary="@string/settings_dj_endpoint_summary"
        android:title="@string/settings_dj_endpoint_title" />

    <Preference
        android:key="dj_test_speech"
        android:summary="@string/settings_dj_test_speech_summary"
        android:title="@string/settings_dj_test_speech_title" />

</PreferenceScreen>
